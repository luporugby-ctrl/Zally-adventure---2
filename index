<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>gDrive Treasure Hunt</title>
    <!-- Import Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Import Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@400;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Press Start 2P', cursive;
            background-color: #5c94fc; /* Sky color */
            overflow: hidden; 
        }
        /* Testo leggibile per i modali e la sottotitolo */
        .font-readable {
            font-family: 'Inter', sans-serif;
        }

        .game-world {
            width: 2400px; /* Mondo più grande per 4 isole */
            height: 100vh;
            position: relative;
        }

        /* --- STILE DEL MARE --- */
        .sea-block {
            background-color: #1e40af; /* Deep blue sea */
            width: 64px;
            height: 64px;
            position: relative;
            overflow: hidden;
        }
        /* Onde stilizzate */
        .sea-block::before {
            content: '';
            position: absolute;
            top: -10px;
            left: 0;
            width: 128px;
            height: 20px;
            background-color: #3b82f6; /* Lighter blue wave */
            border-radius: 50%;
            animation: wave 3s infinite linear;
        }
        .sea-block:nth-child(2n)::before {
            animation-delay: -1.5s;
        }
        @keyframes wave {
            0% { transform: translateX(-64px); }
            100% { transform: translateX(0px); }
        }

        /* --- STILE DI ZALLY E DELLA SUA NAVE --- */
        #zally-container {
            width: 100px; /* Larghezza del container */
            height: 100px; /* Altezza del container */
            position: absolute;
            bottom: 60px; /* Appoggiato sul mare */
            left: 80px;
            z-index: 10;
            transition: left 0.1s linear;
        }
        #zally-image {
            width: 64px; 
            height: 64px;
            position: absolute;
            bottom: 30px; /* In piedi sulla nave */
            left: 18px; /* Centrato sulla nave */
            z-index: 12;
            background-image: url('zally-the-pirate.png'); /* <<< ZALLY CARICATO QUI >>> */
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            /* Flip orizzontale */
            transform-origin: center;
            transition: transform 0.1s linear;
        }
        #ship-hull {
            width: 100px;
            height: 40px;
            background-color: #8B4513; /* Marrone scafo */
            border: 4px solid black;
            border-bottom-left-radius: 20px 10px;
            border-bottom-right-radius: 20px 10px;
            border-top-left-radius: 5px;
            border-top-right-radius: 5px;
            position: absolute;
            bottom: 0;
            left: 0;
            z-index: 11;
        }
        /* Albero della nave */
        #ship-hull::before {
            content: '';
            position: absolute;
            bottom: 40px;
            left: 46px; /* Centrato */
            width: 8px;
            height: 50px;
            background-color: #663300; /* Marrone scuro */
            border: 4px solid black;
            z-index: 9;
        }

        /* --- STILE DELLE ISOLE --- */
        .island {
            width: 160px;
            height: 80px;
            position: absolute;
            bottom: 64px; /* Sul mare */
            cursor: pointer;
            transition: transform 0.1s ease;
            z-index: 5;
        }
        .island:hover {
            transform: scale(1.03);
        }
        /* Terra sotto */
        .island-base {
            width: 100%;
            height: 100%;
            background-color: #e27525; /* Terra */
            border: 4px solid black;
            border-radius: 30px 30px 10px 10px;
        }
        /* Erba sopra */
        .island-top {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 40px;
            background-color: #2dbd2d; /* Verde erba */
            border: 4px solid black;
            border-radius: 30px 30px 0 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px;
            text-align: center;
            line-height: 1.2;
            font-size: 12px;
        }
        /* Isola del tesoro speciale */
        #treasure-island .island-top {
            background-color: #fde047; /* Dorata */
        }
        #treasure-island .island-base {
            background-color: #f59e0b; /* Dorata scura */
        }


        /* --- Stili Modali (dall'ispirazione) --- */
        .modal-pixel {
            font-family: 'Inter', sans-serif; 
            border: 4px solid black;
            box-shadow: 8px 8px 0px black;
        }
        .modal-header-pixel {
             font-family: 'Press Start 2P', cursive;
             border-bottom: 4px solid black;
             background-color: #f87d00;
             color: white;
             text-shadow: 2px 2px 0px black;
        }
        .modal-button-pixel {
             font-family: 'Press Start 2P', cursive;
             border: 4px solid black;
             box-shadow: 4px 4px 0px black;
             transition: all 0.1s ease;
        }
        .modal-button-pixel:hover {
             transform: translate(2px, 2px);
             box-shadow: 2px 2px 0px black;
        }

        /* --- NUOVO: Stile Tesoro Scintillante --- */
        #treasure-chest {
            width: 120px;
            height: 90px;
            background: #8B4513;
            border: 4px solid black;
            border-radius: 10px 10px 0 0;
            position: relative;
            margin: 20px auto 40px;
        }
        /* Coperchio */
        #treasure-chest::before {
            content: '';
            position: absolute;
            top: -20px;
            left: -4px;
            width: 120px;
            height: 30px;
            background: #8B4513;
            border: 4px solid black;
            border-radius: 10px 10px 0 0;
        }
        /* Chiusura */
        #treasure-chest::after {
            content: '';
            position: absolute;
            top: 25px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 10px;
            background: #fde047;
            border: 4px solid black;
        }
        .coin-pile {
            position: absolute;
            bottom: 0;
            left: 10px;
            width: 100px;
            height: 50px;
        }
        .coin {
            position: absolute;
            width: 20px;
            height: 20px;
            background: #fde047;
            border: 2px solid #f59e0b;
            border-radius: 50%;
            animation: shimmer 1.5s infinite;
        }
        @keyframes shimmer {
            0%, 100% { opacity: 0.7; box-shadow: 0 0 5px #fde047; }
            50% { opacity: 1; box-shadow: 0 0 15px #fef08a; }
        }
        .coin:nth-child(1) { bottom: 0; left: 20px; animation-delay: 0s; }
        .coin:nth-child(2) { bottom: 10px; left: 35px; animation-delay: -0.5s; }
        .coin:nth-child(3) { bottom: 0; left: 50px; animation-delay: -1s; }
        .coin:nth-child(4) { bottom: 5px; left: 10px; animation-delay: -0.2s; }
        .coin:nth-child(5) { bottom: 12px; left: 25px; animation-delay: -0.7s; }
        .coin:nth-child(6) { bottom: 5px; left: 60px; animation-delay: -1.2s; }

    </style>
</head>
<body class="m-0 p-0">

    <!-- Barra in alto con i nuovi titoli -->
    <div class="fixed top-0 left-0 w-full bg-black text-white p-4 z-50 text-center">
        <div class="text-sm md:text-base">gDrive Treasure Hunt</div>
        <div class="font-readable text-xs md:text-sm text-gray-300 italic">"Stop *searching*. Start *finding*."</div>
    </div>

    <!-- Il mondo di gioco, ora con il mare -->
    <div class="game-world" id="game-world">
        
        <!-- Zally sulla sua Nave -->
        <div id="zally-container" title="This is Zally!">
            <div id="zally-image"></div>
            <div id="ship-hull"></div>
        </div>

        <!-- Isola 1 -->
        <div class="island challenge-trigger" data-challenge-id="1" style="left: 400px;">
            <div class="island-base"></div>
            <div class="island-top">
                Island 1: FIND
            </div>
        </div>

        <!-- Isola 2 -->
        <div class="island challenge-trigger" data-challenge-id="2" style="left: 900px;">
            <div class="island-base"></div>
            <div class="island-top">
                Island 2: EXTRACT
            </div>
        </div>
        
        <!-- Isola 3 -->
        <div class="island challenge-trigger" data-challenge-id="3" style="left: 1500px;">
            <div class="island-base"></div>
            <div class="island-top">
                Island 3: SYNTHESIZE
            </div>
        </div>
        
        <!-- Isola 4 (Il Tesoro) -->
        <div id="treasure-island" class="island challenge-trigger" data-challenge-id="4" style="left: 2100px;">
            <div class="island-base"></div>
            <div class="island-top">
                💰<br>TREASURE ISLAND
            </div>
        </div>

        <!-- Il Mare (ex "Terra") -->
        <div class="absolute bottom-0 left-0 flex flex-row z-0">
            <script>
                // Genera 38 blocchi di mare per coprire 2400px
                for (let i = 0; i < 38; i++) {
                    document.write('<div class="sea-block"></div>');
                }
            </script>
        </div>
    </div>

    <!-- Modale per le Sfide (Nascosto) -->
    <div id="modal-overlay" class="fixed inset-0 bg-black bg-opacity-70 z-40 hidden"></div>
    <div id="challenge-modal" class="fixed top-1/2 left-1/2 w-11/12 max-w-2xl -translate-x-1/2 -translate-y-1/2 bg-white rounded-lg z-50 hidden modal-pixel">
        <div id="modal-title" class="p-4 text-xl modal-header-pixel"></div>
        <div class="p-6 text-gray-800 space-y-4 font-readable">
            <p id="modal-concept" class="text-base">Zally is stuck! He needs the right prompt to sail to the next island. This is your objective:</p>
            <p id="modal-objective" class="text-lg font-bold"></p>
            
            <div class="bg-red-100 border-2 border-red-500 p-3 rounded-lg">
                <h3 class="font-bold text-red-700">Weak Prompt (Zally is stuck!):</h3>
                <p id="modal-bad-prompt" class="text-sm mt-1 font-mono"></p>
            </div>
            <div class="bg-green-100 border-2 border-green-600 p-3 rounded-lg">
                <h3 class="font-bold text-green-800">Strong Prompt (Full speed ahead!):</h3>
                <p id="modal-good-prompt" class="text-sm mt-1 font-mono"></p>
            </div>
            <p id="modal-takeaway" class="pt-4 text-base font-bold"></p>
        </div>
        <div class="p-4 bg-gray-100 border-t-4 border-black flex justify-end">
            <button id="close-modal-btn" class="modal-button-pixel bg-blue-500 text-white px-6 py-2 rounded-lg">
                Sail On!
            </button>
        </div>
    </div>

    <!-- NUOVO: Modale per il Tesoro (Nascosto) -->
    <div id="treasure-modal" class="fixed top-1/2 left-1/2 w-11/12 max-w-2xl -translate-x-1/2 -translate-y-1/2 bg-white rounded-lg z-50 hidden modal-pixel">
        <div class="p-4 text-xl modal-header-pixel">TREASURE UNLOCKED!</div>
        <div class="p-6 text-gray-800 space-y-4 font-readable text-center">
            
            <h2 class="text-2xl font-bold text-amber-900">Zally found the treasure!</h2>
            <p class="text-base">Thanks to your powerful prompts, you've mastered the gDrive Hunt!</p>
            
            <!-- Baule del Tesoro e Monete Scintillanti -->
            <div id="treasure-chest">
                <div class="coin-pile">
                    <div class="coin"></div>
                    <div class="coin"></div>
                    <div class="coin"></div>
                    <div class="coin"></div>
                    <div class="coin"></div>
                    <div class="coin"></div>
                </div>
            </div>

            <h3 class="text-xl font-bold pt-4">Your New Superpowers:</h3>
            <ul class="mt-2 space-y-2 text-lg text-left inline-block">
                <li>🧠 Find <strong>concepts</strong>, not just file names.</li>
                <li>💡 <strong>Summarize</strong> files on the fly.</li>
                <li>💬 Get <strong>answers</strong> from multiple documents.</li>
            </ul>
        </div>
        <div class="p-4 bg-gray-100 border-t-4 border-black flex justify-end">
            <button id="close-treasure-modal-btn" class="modal-button-pixel bg-green-600 text-white px-6 py-2 rounded-lg">
                Awesome!
            </button>
        </div>
    </div>


    <script>
        // --- Contenuto delle Challenge (Specifico per gDrive) ---
        const challenges = [
            { 
                id: 1, 
                title: "Island 1: FIND THE PLAN", 
                concept: "Zally is lost in a sea of files. He needs to find the *right* document, even if he doesn't know the name.",
                objective: "Find the main project document for the 'Supplier Returns' initiative.",
                badPrompt: "'supplier returns'",
                goodPrompt: "'Find the Project Plan for Supplier Returns Process Improvement'", 
                takeaway: "Gemini understands concepts, not just keywords. Ask *what* you want, not just what you remember." 
            },
            { 
                id: 2, 
                title: "Island 2: EXTRACT THE OWNER", 
                concept: "Zally found the island (file), but doesn't want to dig for hours. He needs to get info *without opening the file*.",
                objective: "Who is the owner of this initiative, according to the kick-off presentation?",
                badPrompt: "*[Opens file, wastes 5 minutes reading]*", 
                goodPrompt: "Right-click the file in Drive and use Gemini's summary feature, or ask: 'Who is the owner of the Supplier Returns project?'", 
                takeaway: "Use Gemini's contextual summary to get answers *on the fly*."
            },
            { 
                id: 3, 
                title: "Island 3: SYNTHESIZE UPDATES", 
                concept: "Zally needs one answer, but the info is on three different islands (files).",
                objective: "What are the latest updates and next deadlines for the project?",
                badPrompt: "*[Opens file 1, then 2, then 3... copies/pastes notes]*", 
                goodPrompt: "'Summarize key updates and next deadlines from the Supplier Returns initiative'", 
                takeaway: "Gemini can read *multiple* documents at once to give you a single, synthesized answer."
            }
            // L'ID 4 è il tesoro, non ha bisogno di dati qui.
        ];

        // --- Logica dei Modali ---
        const modalOverlay = document.getElementById('modal-overlay');
        const challengeModal = document.getElementById('challenge-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');
        const treasureModal = document.getElementById('treasure-modal');
        const closeTreasureModalBtn = document.getElementById('close-treasure-modal-btn');
        const challengeTriggers = document.querySelectorAll('.challenge-trigger');
        
        // Campi del modale
        const modalTitle = document.getElementById('modal-title');
        const modalConcept = document.getElementById('modal-concept');
        const modalObjective = document.getElementById('modal-objective');
        const modalBadPrompt = document.getElementById('modal-bad-prompt');
        const modalGoodPrompt = document.getElementById('modal-good-prompt');
        const modalTakeaway = document.getElementById('modal-takeaway');

        let isModalOpen = false;

        function openChallengeModal(challenge) {
            isModalOpen = true;
            modalTitle.textContent = challenge.title;
            modalConcept.textContent = challenge.concept;
            modalObjective.textContent = challenge.objective;
            modalBadPrompt.textContent = challenge.badPrompt;
            modalGoodPrompt.textContent = challenge.goodPrompt;
            modalTakeaway.textContent = challenge.takeaway;
            modalOverlay.classList.remove('hidden');
            challengeModal.classList.remove('hidden');
        }

        function openTreasureModal() {
            isModalOpen = true;
            modalOverlay.classList.remove('hidden');
            treasureModal.classList.remove('hidden');
        }

        function closeModal() {
            isModalOpen = false;
            modalOverlay.classList.add('hidden');
            challengeModal.classList.add('hidden');
            treasureModal.classList.add('hidden');
        }

        challengeTriggers.forEach(trigger => {
            trigger.addEventListener('click', (event) => {
                event.stopPropagation();
                const challengeId = parseInt(trigger.dataset.challengeId);
                
                if (challengeId === 4) {
                    // È l'isola del tesoro!
                    openTreasureModal();
                } else {
                    // È un'isola di sfida
                    const challengeData = challenges.find(c => c.id === challengeId);
                    if (challengeData) {
                        openChallengeModal(challengeData);
                    }
                }
            });
        });

        closeModalBtn.addEventListener('click', closeModal);
        closeTreasureModalBtn.addEventListener('click', closeModal);
        modalOverlay.addEventListener('click', closeModal);

        // --- Logica di Movimento (dall'ispirazione) ---
        const gameWorld = document.getElementById('game-world');
        const zallyContainer = document.getElementById('zally-container');
        const zallyImage = document.getElementById('zally-image'); // Immagine di Zally
        let zallyPositionX = 80;
        const moveSpeed = 15;
        const worldWidth = 2400;
        let screenWidth = window.innerWidth;
        
        window.addEventListener('resize', () => { screenWidth = window.innerWidth; });

        document.addEventListener('keydown', (e) => {
            if (isModalOpen) return;

            if (e.key === 'ArrowRight') {
                zallyPositionX = Math.min(zallyPositionX + moveSpeed, worldWidth - zallyContainer.offsetWidth - 10);
                zallyImage.style.transform = 'scaleX(1)'; // Guarda a destra
            } else if (e.key === 'ArrowLeft') {
                zallyPositionX = Math.max(zallyPositionX - moveSpeed, 0);
                zallyImage.style.transform = 'scaleX(-1)'; // Guarda a sinistra (flippato)
            }

            zallyContainer.style.left = zallyPositionX + 'px';

            // Logica della "Camera" per seguire Zally
            let cameraLookAhead = screenWidth / 3;
            let targetScrollLeft = zallyPositionX - cameraLookAhead;
            targetScrollLeft = Math.max(0, targetScrollLeft);
            targetScrollLeft = Math.min(targetScrollLeft, worldWidth - screenWidth);
            
            // Animazione di scrolling fluida
            window.scrollTo({
                left: targetScrollLeft,
                behavior: 'smooth'
            });
        });
    </script>
</body>
</html>


